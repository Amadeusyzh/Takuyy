#!/usr/bin/env bash
# Usage: site-check <slug> [<slug> ...]
# Serves _site under /Takuyy/ and checks each post in en, zh-cn and ja-jp at 390 and 1100 px:
# figures loaded, page overflow, unrendered math, widget drag, console errors.
# Screenshots: /tmp/shots/<slug>-<lang>-<width>.png, plus per-figure and per-widget shots at 390 px.
set -uo pipefail
mkdir -p /tmp/serve /tmp/shots
ln -sfn "$SITE_DIR/_site" /tmp/serve/Takuyy
if ! curl -s -o /dev/null http://127.0.0.1:4000/Takuyy/; then
  (cd /tmp/serve && nohup python3 -m http.server 4000 > /tmp/serve.log 2>&1 &)
  sleep 2
fi
node "$OPS_TOOLS/site-check.js" "$@"
