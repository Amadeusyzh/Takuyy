{% assign t = site.data[site.active_lang].strings.lab %}
<style>
  .lab { clear: both; margin: 2.2rem 0 1rem; }
  .lab h3 { margin-bottom: 0.3rem; font-size: 1.35rem; }
  .lab-intro { font-size: 0.9rem; color: var(--global-text-color-light); margin-bottom: 0.8rem; }
  .lab-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--global-divider-color); margin-bottom: 0.8rem; overflow-x: auto; scrollbar-width: none; }
  .lab-tabs::-webkit-scrollbar { display: none; }
  .lab-tabs button { background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 0.4rem 0.9rem; color: var(--global-text-color-light); font-size: 0.9rem; cursor: pointer; white-space: nowrap; flex: none; }
  .lab-tabs button[aria-selected="true"] { color: var(--global-theme-color); border-bottom-color: var(--global-theme-color); font-weight: 600; }
  .lab-panel[hidden] { display: none; }
  .lab-stage { position: relative; border: 1px solid var(--global-divider-color); border-radius: 8px; overflow: hidden; background: #0e1014; }
  .lab-stage canvas { display: block; width: 100%; aspect-ratio: 16 / 9; touch-action: pan-y; cursor: crosshair; user-select: none; -webkit-user-select: none; }
  .lab-stage .lab-hint { position: absolute; right: 10px; top: 8px; font-size: 0.75rem; color: rgba(255, 255, 255, 0.75); pointer-events: none; transition: opacity 0.6s; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); }
  .lab-stage .lab-stats { position: absolute; left: 10px; bottom: 8px; font: 0.72rem/1.3 monospace; color: rgba(255, 255, 255, 0.85); pointer-events: none; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7); }
  .lab-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-top: 0.6rem; font-size: 0.85rem; }
  .lab-seg { display: inline-flex; border: 1px solid var(--global-divider-color); border-radius: 6px; overflow: hidden; }
  .lab button.lab-b { background: transparent; color: var(--global-text-color); border: 0; padding: 0.25rem 0.7rem; font-size: 0.85rem; cursor: pointer; }
  .lab-seg .lab-b + .lab-b { border-left: 1px solid var(--global-divider-color); }
  .lab button.lab-b[aria-pressed="true"] { background: var(--global-theme-color); color: var(--global-bg-color); }
  .lab button.lab-solo { border: 1px solid var(--global-divider-color); border-radius: 6px; }
  .lab label { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; }
  .lab input[type="range"] { width: 110px; accent-color: var(--global-theme-color); }
  @media (max-width: 576px) {
    .lab-tabs button { font-size: 0.8rem; padding: 0.4rem 0.5rem; }
    .lab-stage .lab-hint { display: none; }
    .lab-stage .lab-stats { font-size: 0.62rem; }
  }
  .pt-editor { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-top: 0.5rem; padding: 0.5rem 0.7rem; border: 1px dashed var(--global-divider-color); border-radius: 6px; font-size: 0.85rem; }
  .pt-selname { font-weight: 600; }
  .pt-material { display: contents; }
  .pt-material[hidden] { display: none; }
  .pt-swatches { display: inline-flex; gap: 4px; }
  .pt-swatch { width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--global-divider-color); padding: 0; cursor: pointer; }
  .gw-promptbar { display: flex; gap: 0.5rem; margin-top: 0.6rem; }
  .gw-prompt { flex: 1; min-width: 0; padding: 0.35rem 0.6rem; border: 1px solid var(--global-divider-color); border-radius: 6px; background: var(--global-bg-color); color: var(--global-text-color); font-size: 0.9rem; }
  .lab button.gw-go { background: var(--global-theme-color); color: var(--global-bg-color); }
  .gw-presets { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.45rem; }
  .gw-chip { border: 1px solid var(--global-divider-color); border-radius: 999px; background: transparent; color: var(--global-text-color-light); font-size: 0.75rem; padding: 0.15rem 0.6rem; cursor: pointer; }
  .gw-chip:hover { color: var(--global-theme-color); border-color: var(--global-theme-color); }
  .gw-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; margin-top: 0.4rem; font-size: 0.75rem; min-height: 1.2rem; }
  .gw-tag-label { color: var(--global-text-color-light); }
  .gw-tag { background: var(--global-theme-color); color: var(--global-bg-color); border-radius: 4px; padding: 0 0.4rem; }
  .gw-ui [hidden] { display: none !important; }
  .lab-stage .gw-flash { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%); max-width: 90%; text-align: center; padding: 0.4rem 0.9rem; border-radius: 6px; background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 0.85rem; pointer-events: none; opacity: 0; transition: opacity 0.4s; }
  .lab-stage .gw-drop { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(255, 255, 255, 0.7); border-radius: 8px; background: rgba(0, 0, 0, 0.45); color: #fff; font-size: 0.95rem; pointer-events: none; opacity: 0; transition: opacity 0.2s; }
  .lab-stage.gw-dragover .gw-drop { opacity: 1; }
  .lab-caption { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.55; color: var(--global-text-color-light); }
</style>
<section class="lab" id="lab" data-nogl="{{ t.nogl }}" data-nogl2="{{ t.nogl2 }}">
  <h3>{{ t.title }}</h3>
  <p class="lab-intro">{{ t.intro }}</p>
  <div class="lab-tabs" role="tablist">
    <button type="button" role="tab" aria-selected="true" aria-controls="lab-pt" id="lab-tab-pt">{{ t.tab_pt }}</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="lab-rs" id="lab-tab-rs">{{ t.tab_rs }}</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="lab-gs" id="lab-tab-gs">{{ t.tab_gs }}</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="lab-cloth" id="lab-tab-cloth">{{ t.tab_cloth }}</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="lab-fov" id="lab-tab-fov">{{ t.tab_fov }}</button>
  </div>
  <div class="lab-panel" role="tabpanel" id="lab-pt" aria-labelledby="lab-tab-pt" data-stats="{{ t.pt_stats }}" data-nosel="{{ t.nosel }}" data-obj0="{{ t.obj0 }}" data-obj1="{{ t.obj1 }}" data-obj2="{{ t.obj2 }}" data-obj3="{{ t.obj3 }}">
    <div class="lab-stage">
      <canvas aria-label="{{ t.tab_pt }}" role="img" style="touch-action: none; cursor: pointer"></canvas>
      <span class="lab-hint">{{ t.pt_hint }}</span>
      <span class="lab-stats"></span>
    </div>
    <div class="lab-controls">
      <span>{{ t.sampling }}</span>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-mode="0">BSDF</button>
        <button type="button" class="lab-b" data-mode="1">NEE</button>
        <button type="button" class="lab-b" data-mode="2">MIS</button>
      </div>
      <button type="button" class="lab-b lab-solo" data-toggle="denoise" aria-pressed="true">{{ t.denoise }}</button>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-view="0">{{ t.v_final }}</button>
        <button type="button" class="lab-b" data-view="1">{{ t.v_noisy }}</button>
        <button type="button" class="lab-b" data-view="2">{{ t.v_albedo }}</button>
        <button type="button" class="lab-b" data-view="3">{{ t.v_normal }}</button>
        <button type="button" class="lab-b" data-view="4">{{ t.v_depth }}</button>
      </div>
      <label>{{ t.bounces }} <input type="range" data-input="bounces" min="1" max="8" step="1"></label>
      <label>{{ t.light }} <input type="range" data-input="light" min="0" max="1" step="0.01"></label>
      <label>{{ t.aperture }} <input type="range" data-input="aperture" min="0" max="0.15" step="0.005"></label>
      <button type="button" class="lab-b lab-solo" data-action="reset">{{ t.reset }}</button>
    </div>
    <div class="pt-editor">
      <span class="pt-selname"></span>
      <div class="pt-material" hidden>
        <div class="lab-seg" role="group">
          <button type="button" class="lab-b" data-preset="diffuse">{{ t.m_diffuse }}</button>
          <button type="button" class="lab-b" data-preset="plastic">{{ t.m_plastic }}</button>
          <button type="button" class="lab-b" data-preset="metal">{{ t.m_metal }}</button>
          <button type="button" class="lab-b" data-preset="mirror">{{ t.m_mirror }}</button>
          <button type="button" class="lab-b" data-preset="glass">{{ t.m_glass }}</button>
          <button type="button" class="lab-b" data-preset="frosted">{{ t.m_frosted }}</button>
        </div>
        <label>{{ t.roughness }} <input type="range" data-input="rough" min="0" max="1" step="0.01"></label>
        <div class="pt-swatches"></div>
      </div>
    </div>
    <p class="lab-caption">{{ t.pt_caption }}</p>
  </div>
  <div class="lab-panel" role="tabpanel" id="lab-rs" aria-labelledby="lab-tab-rs" data-stats="{{ t.rs_stats }}" hidden>
    <div class="lab-stage">
      <canvas aria-label="{{ t.tab_rs }}" role="img" style="touch-action: none; cursor: grab"></canvas>
      <span class="lab-hint">{{ t.rs_hint }}</span>
      <span class="lab-stats"></span>
    </div>
    <div class="lab-controls">
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-rmode="0">{{ t.rs_uniform }}</button>
        <button type="button" class="lab-b" data-rmode="1">{{ t.rs_ris }}</button>
        <button type="button" class="lab-b" data-rmode="2">{{ t.rs_temporal }}</button>
        <button type="button" class="lab-b" data-rmode="3">{{ t.rs_spatial }}</button>
      </div>
      <span>{{ t.rs_lights }}</span>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-lights="128">128</button>
        <button type="button" class="lab-b" data-lights="512">512</button>
        <button type="button" class="lab-b" data-lights="1024">1024</button>
      </div>
      <label>{{ t.rs_candidates }} <input type="range" data-input="candidates" min="1" max="64" step="1"> <span class="rs-m"></span></label>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-toggle="animate">{{ t.rs_animate }}</button>
        <button type="button" class="lab-b" data-toggle="walk">{{ t.rs_walk }}</button>
      </div>
    </div>
    <p class="lab-caption">{{ t.rs_caption }}</p>
  </div>
  <div class="lab-panel" role="tabpanel" id="lab-gs" aria-labelledby="lab-tab-gs" data-stats="{{ t.gs_stats }}" data-understood="{{ t.gw_understood }}" data-loading="{{ t.gw_loading }}" data-loaded="{{ t.gw_loaded }}" data-full="{{ t.gw_full }}" data-stats-capture="{{ t.gs_stats_capture }}" data-ply-loading="{{ t.gw_ply_loading }}" data-ply-loaded="{{ t.gw_ply_loaded }}" data-ply-capped="{{ t.gw_ply_capped }}" data-ply-bad="{{ t.gw_ply_bad }}" data-ply-big="{{ t.gw_ply_big }}" data-drop="{{ t.gw_drop }}" data-tags='{{ t.gw_tags | jsonify }}' hidden>
    <div class="lab-stage">
      <canvas aria-label="{{ t.tab_gs }}" role="img" style="touch-action: none; cursor: grab; outline: none"></canvas>
      <span class="lab-hint">{{ t.gs_hint }}</span>
      <span class="lab-stats"></span>
      <span class="gw-flash"></span>
      <span class="gw-drop">{{ t.gw_drop }}</span>
    </div>
    <div class="gw-ui">
      <div class="gw-promptbar gw-gen">
        <input type="text" class="gw-prompt" placeholder="{{ t.gw_placeholder }}" aria-label="{{ t.gw_placeholder }}">
        <button type="button" class="lab-b lab-solo gw-go" data-action="generate">{{ t.gw_generate }}</button>
        <button type="button" class="lab-b lab-solo" data-action="random">{{ t.gw_random }}</button>
      </div>
      <div class="gw-presets gw-gen">{% for pr in t.gw_presets %}<button type="button" class="gw-chip" data-preset-prompt="{{ pr }}">{{ pr }}</button>{% endfor %}</div>
      <div class="gw-tags gw-gen"></div>
      <div class="lab-controls gw-gen">
        <div class="lab-seg" role="group">
          <button type="button" class="lab-b" data-tool="orbit">{{ t.t_orbit }}</button>
          <button type="button" class="lab-b" data-tool="walk">{{ t.t_walk }}</button>
          <button type="button" class="lab-b" data-tool="place">{{ t.t_place }}</button>
          <button type="button" class="lab-b" data-tool="erase">{{ t.t_erase }}</button>
          <button type="button" class="lab-b" data-tool="raise">{{ t.t_raise }}</button>
          <button type="button" class="lab-b" data-tool="lower">{{ t.t_lower }}</button>
          <button type="button" class="lab-b" data-tool="smooth">{{ t.t_smooth }}</button>
          <button type="button" class="lab-b" data-tool="paint">{{ t.t_paint }}</button>
        </div>
        <div class="lab-seg gw-objs" role="group" hidden>
          <button type="button" class="lab-b" data-obj="tree">{{ t.o_tree }}</button>
          <button type="button" class="lab-b" data-obj="pine">{{ t.o_pine }}</button>
          <button type="button" class="lab-b" data-obj="sakura">{{ t.o_sakura }}</button>
          <button type="button" class="lab-b" data-obj="rock">{{ t.o_rock }}</button>
          <button type="button" class="lab-b" data-obj="flowers">{{ t.o_flowers }}</button>
          <button type="button" class="lab-b" data-obj="cabin">{{ t.o_cabin }}</button>
          <button type="button" class="lab-b" data-obj="lantern">{{ t.o_lantern }}</button>
        </div>
        <div class="lab-seg gw-biomes" role="group" hidden>
          <button type="button" class="lab-b" data-biome="1">{{ t.b_grass }}</button>
          <button type="button" class="lab-b" data-biome="2">{{ t.b_meadow }}</button>
          <button type="button" class="lab-b" data-biome="3">{{ t.b_sand }}</button>
          <button type="button" class="lab-b" data-biome="4">{{ t.b_snow }}</button>
          <button type="button" class="lab-b" data-biome="5">{{ t.b_rock }}</button>
          <button type="button" class="lab-b" data-biome="6">{{ t.b_path }}</button>
        </div>
        <label class="gw-brush" hidden>{{ t.gw_brush }} <input type="range" data-input="brush" min="1" max="12" step="0.5"></label>
      </div>
      <div class="lab-controls gw-gen">
        <label>{{ t.gw_time }} <input type="range" data-input="time" min="0" max="24" step="0.05"> <span class="gw-time-label"></span></label>
        <div class="lab-seg" role="group">
          <button type="button" class="lab-b" data-season="0">{{ t.s_spring }}</button>
          <button type="button" class="lab-b" data-season="1">{{ t.s_summer }}</button>
          <button type="button" class="lab-b" data-season="2">{{ t.s_autumn }}</button>
          <button type="button" class="lab-b" data-season="3">{{ t.s_winter }}</button>
        </div>
        <label>{{ t.gw_wind }} <input type="range" data-input="wind" min="0" max="2.5" step="0.05"></label>
        <label>{{ t.gw_fog }} <input type="range" data-input="fog" min="0" max="0.06" step="0.001"></label>
        <label>{{ t.gw_water }} <input type="range" data-input="water" min="-2" max="2.5" step="0.05"></label>
        <div class="lab-seg" role="group">
          <button type="button" class="lab-b" data-toggle="shadows">{{ t.gw_shadows }}</button>
          <button type="button" class="lab-b" data-toggle="timelapse">{{ t.gw_timelapse }}</button>
        </div>
      </div>
      <div class="lab-controls">
        <div class="lab-seg" role="group">
          <button type="button" class="lab-b" data-gmode="0">{{ t.g_render }}</button>
          <button type="button" class="lab-b" data-gmode="1">{{ t.g_ellip }}</button>
          <button type="button" class="lab-b" data-gmode="2">{{ t.g_centers }}</button>
          <button type="button" class="lab-b" data-gmode="4">{{ t.g_overdraw }}</button>
          <button type="button" class="lab-b" data-gmode="3">{{ t.g_depth }}</button>
        </div>
        <button type="button" class="lab-b lab-solo" data-action="load-ply">{{ t.gw_load }}</button>
        <input type="file" class="gw-file" accept=".ply" hidden>
        <button type="button" class="lab-b lab-solo gw-cap" data-action="flip" hidden>{{ t.gw_flip }}</button>
        <button type="button" class="lab-b lab-solo gw-cap" data-action="back" hidden>{{ t.gw_back }}</button>
      </div>
    </div>
    <p class="lab-caption">{{ t.gs_caption }}</p>
  </div>
  <div class="lab-panel" role="tabpanel" id="lab-cloth" aria-labelledby="lab-tab-cloth" data-stats="{{ t.cloth_stats }}" hidden>
    <div class="lab-stage">
      <canvas aria-label="{{ t.tab_cloth }}" role="img"></canvas>
      <span class="lab-hint">{{ t.cloth_hint }}</span>
      <span class="lab-stats"></span>
    </div>
    <div class="lab-controls">
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-tool="grab" aria-pressed="true">{{ t.grab }}</button>
        <button type="button" class="lab-b" data-tool="cut" aria-pressed="false">{{ t.cut }}</button>
      </div>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-toggle="wind" aria-pressed="true">{{ t.wind }}</button>
        <button type="button" class="lab-b" data-toggle="ball" aria-pressed="true">{{ t.ball }}</button>
        <button type="button" class="lab-b" data-toggle="tear" aria-pressed="true">{{ t.tear }}</button>
      </div>
      <label>{{ t.stiffness }} <input type="range" data-input="stiffness" min="0" max="1" step="0.01" value="0.85"></label>
      <button type="button" class="lab-b lab-solo" data-action="release">{{ t.release }}</button>
      <button type="button" class="lab-b lab-solo" data-action="reset">{{ t.reset }}</button>
    </div>
    <p class="lab-caption">{{ t.cloth_caption }}</p>
  </div>
  <div class="lab-panel" role="tabpanel" id="lab-fov" aria-labelledby="lab-tab-fov" data-stats="{{ t.fov_stats }}" hidden>
    <div class="lab-stage">
      <canvas aria-label="{{ t.tab_fov }}" role="img" style="cursor: none"></canvas>
      <span class="lab-hint">{{ t.fov_hint }}</span>
      <span class="lab-stats"></span>
    </div>
    <div class="lab-controls">
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-toggle="foveation" aria-pressed="true">{{ t.foveation }}</button>
        <button type="button" class="lab-b" data-toggle="regions" aria-pressed="false">{{ t.regions }}</button>
      </div>
      <label>{{ t.radius }} <input type="range" data-input="radius" min="0.06" max="0.4" step="0.01" value="0.16"></label>
      <button type="button" class="lab-b lab-solo" data-action="play" data-play="{{ t.play }}" data-resume="{{ t.resume }}">{{ t.play }}</button>
    </div>
    <p class="lab-caption">{{ t.fov_caption }}</p>
  </div>
</section>
<script defer src="{{ '/assets/js/lab.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/lab-pathtracer.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/lab-restir.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/lab-splats.js' | relative_url }}"></script>
