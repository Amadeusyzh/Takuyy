<style>
  .sky-val { display: inline-block; min-width: 3.4em; font-variant-numeric: tabular-nums; color: var(--global-text-color-light); }
  .lab-stage .sky-legend { position: absolute; left: 10px; top: 8px; max-width: 70%; font: 0.7rem/1.3 monospace; color: rgba(255, 255, 255, 0.9); pointer-events: none; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8); }
  .lab-stage .sky-legend[hidden] { display: none; }
  @media (max-width: 576px) {
    .lab-stage .sky-legend { font-size: 0.6rem; }
  }
</style>
<div class="lab-panel" role="tabpanel" id="lab-sky" aria-labelledby="lab-tab-sky" data-lang="{{ site.active_lang | slice: 0, 2 }}" hidden>
  <div class="lab-stage">
    <canvas role="img" style="touch-action: none; cursor: grab"></canvas>
    <span class="lab-hint"></span>
    <span class="lab-stats"></span>
    <span class="sky-legend" hidden></span>
  </div>
  <div class="lab-controls">
    <label><span data-t="time"></span> <input type="range" data-input="time" min="4.5" max="19.5" step="0.01"> <span class="sky-val" data-val="time"></span></label>
    <label><span data-t="coverage"></span> <input type="range" data-input="cov" min="0" max="1" step="0.01"> <span class="sky-val" data-val="cov"></span></label>
    <label><span data-t="density"></span> <input type="range" data-input="dens" min="0.01" max="0.15" step="0.001"> <span class="sky-val" data-val="dens"></span></label>
    <label><span data-t="altitude"></span> <input type="range" data-input="alt" min="0.1" max="8" step="0.05"> <span class="sky-val" data-val="alt"></span></label>
  </div>
  <div class="lab-controls">
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-phase="0" data-t="p0"></button>
      <button type="button" class="lab-b" data-phase="1" data-t="p1"></button>
      <button type="button" class="lab-b" data-phase="2" data-t="p2"></button>
    </div>
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-toggle="ms" data-t="ms"></button>
      <button type="button" class="lab-b" data-toggle="powder" data-t="powder"></button>
    </div>
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-toggle="wind" data-t="wind"></button>
      <button type="button" class="lab-b" data-toggle="taa" data-t="taa"></button>
    </div>
  </div>
  <div class="lab-controls">
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-view="0" data-t="v0"></button>
      <button type="button" class="lab-b" data-view="1" data-t="v1"></button>
      <button type="button" class="lab-b" data-view="2" data-t="v2"></button>
      <button type="button" class="lab-b" data-view="3" data-t="v3"></button>
    </div>
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-preset="0" data-t="pr0"></button>
      <button type="button" class="lab-b" data-preset="1" data-t="pr1"></button>
      <button type="button" class="lab-b" data-preset="2" data-t="pr2"></button>
      <button type="button" class="lab-b" data-preset="3" data-t="pr3"></button>
    </div>
  </div>
  <p class="lab-caption"><span data-t="caption"></span> <a href="{{ '/blog/2026/graphics-10-volumes-and-participating-media/' | relative_url }}" data-t="link"></a></p>
</div>
