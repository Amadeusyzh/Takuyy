{% assign d = site.data[site.active_lang].strings.demo %}
<style>
  .sdf-demo { clear: both; margin: 2rem 0 1rem; }
  .sdf-demo h3 { margin-bottom: 0.75rem; font-size: 1.35rem; }
  .sdf-demo-stage { position: relative; border: 1px solid var(--global-divider-color); border-radius: 8px; overflow: hidden; background: var(--global-bg-color); }
  .sdf-demo-stage canvas { display: block; width: 100%; aspect-ratio: 16 / 9; cursor: grab; touch-action: pan-y; }
  .sdf-demo-stage canvas:active { cursor: grabbing; }
  .sdf-demo-hint { position: absolute; right: 10px; bottom: 8px; font-size: 0.75rem; color: var(--global-text-color-light); pointer-events: none; transition: opacity 0.6s; }
  .sdf-demo-fps { position: absolute; left: 10px; bottom: 8px; font: 0.7rem/1 monospace; color: var(--global-text-color-light); pointer-events: none; }
  .sdf-demo-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.6rem; font-size: 0.85rem; }
  .sdf-demo-modes { display: inline-flex; border: 1px solid var(--global-divider-color); border-radius: 6px; overflow: hidden; }
  .sdf-demo button { background: transparent; color: var(--global-text-color); border: 0; padding: 0.25rem 0.7rem; font-size: 0.85rem; cursor: pointer; }
  .sdf-demo-modes button + button { border-left: 1px solid var(--global-divider-color); }
  .sdf-demo-modes button[aria-pressed="true"] { background: var(--global-theme-color); color: var(--global-bg-color); }
  .sdf-demo-btn { border: 1px solid var(--global-divider-color) !important; border-radius: 6px; }
  .sdf-demo label { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; }
  .sdf-demo input[type="range"] { width: 120px; accent-color: var(--global-theme-color); }
  .sdf-demo-k { font-family: monospace; min-width: 2.5em; }
  .sdf-demo figcaption { margin-top: 0.6rem; font-size: 0.85rem; color: var(--global-text-color-light); }
</style>
<figure class="sdf-demo" id="sdf-demo" data-play="{{ d.play }}" data-resume="{{ d.resume }}" data-nogl="{{ d.nogl }}">
  <h3>{{ d.title }}</h3>
  <div class="sdf-demo-stage">
    <canvas aria-label="{{ d.title }}" role="img"></canvas>
    <span class="sdf-demo-hint">{{ d.hint }}</span>
    <span class="sdf-demo-fps"></span>
  </div>
  <div class="sdf-demo-controls">
    <div class="sdf-demo-modes" role="group">
      <button type="button" data-mode="0" aria-pressed="true">{{ d.shaded }}</button>
      <button type="button" data-mode="1" aria-pressed="false">{{ d.normals }}</button>
      <button type="button" data-mode="2" aria-pressed="false">{{ d.steps }}</button>
    </div>
    <label>{{ d.blend }} <input type="range" min="0" max="0.8" step="0.01" value="0.35"> <span class="sdf-demo-k">0.35</span></label>
    <button type="button" class="sdf-demo-btn" data-action="play">{{ d.play }}</button>
    <button type="button" class="sdf-demo-btn" data-action="reset">{{ d.reset }}</button>
  </div>
  <figcaption>{{ d.caption }}</figcaption>
</figure>
<script defer src="{{ '/assets/js/sdf_demo.js' | relative_url }}"></script>
