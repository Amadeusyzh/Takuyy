<style>
  .sdf-editor { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-top: 0.5rem; padding: 0.5rem 0.7rem; border: 1px dashed var(--global-divider-color); border-radius: 6px; font-size: 0.85rem; min-height: 2.6rem; }
  .sdf-selname { font-weight: 600; }
  .sdf-seltools { display: contents; }
  .sdf-seltools[hidden], .lab-panel .sdf-shapes[hidden], .lab-panel .sdf-slice[hidden] { display: none; }
  .sdf-k, .sdf-steps { display: inline-block; min-width: 2.1em; font-variant-numeric: tabular-nums; color: var(--global-text-color-light); }
  .lab-stage .sdf-legend { position: absolute; left: 10px; top: 8px; display: grid; grid-template-columns: auto auto; gap: 2px 8px; font: 0.68rem/1.2 monospace; color: rgba(255, 255, 255, 0.85); pointer-events: none; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7); }
  .lab-stage .sdf-legend[hidden] { display: none; }
  .sdf-legend-bar { grid-column: 1 / 3; width: 128px; height: 8px; border-radius: 2px; background: linear-gradient(90deg, rgb(15, 10, 61), rgb(31, 107, 219) 25%, rgb(51, 199, 140) 50%, rgb(250, 204, 51) 75%, rgb(219, 41, 26)); }
  .sdf-legend-hi { text-align: right; }
  .sdf-legend-over { grid-column: 1 / 3; }
  @media (max-width: 576px) {
    .lab-stage .sdf-legend { font-size: 0.58rem; }
    .sdf-legend-bar { width: 84px; }
  }
</style>
<div class="lab-panel" role="tabpanel" id="lab-sdf" aria-labelledby="lab-tab-sdf" data-lang="{{ site.active_lang | slice: 0, 2 }}" hidden>
  <div class="lab-stage">
    <canvas role="img" style="touch-action: none; cursor: grab"></canvas>
    <span class="lab-hint"></span>
    <span class="lab-stats"></span>
    <span class="sdf-legend" hidden><span class="sdf-legend-bar"></span><span data-t="lo"></span><span class="sdf-legend-hi"></span><span class="sdf-legend-over" data-t="over"></span></span>
  </div>
  <div class="lab-controls">
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-tool="move" data-t="t_move"></button>
      <button type="button" class="lab-b" data-tool="add" data-t="t_add"></button>
      <button type="button" class="lab-b" data-tool="probe" data-t="t_probe"></button>
    </div>
    <div class="lab-seg sdf-shapes" role="group" hidden>
      <button type="button" class="lab-b" data-shape="0" data-t="s0"></button>
      <button type="button" class="lab-b" data-shape="1" data-t="s1"></button>
      <button type="button" class="lab-b" data-shape="2" data-t="s2"></button>
      <button type="button" class="lab-b" data-shape="3" data-t="s3"></button>
    </div>
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-preset="0" data-t="p0"></button>
      <button type="button" class="lab-b" data-preset="1" data-t="p1"></button>
      <button type="button" class="lab-b" data-preset="2" data-t="p2"></button>
    </div>
  </div>
  <div class="lab-controls">
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-view="0" data-t="v0"></button>
      <button type="button" class="lab-b" data-view="1" data-t="v1"></button>
      <button type="button" class="lab-b" data-view="2" data-t="v2"></button>
    </div>
    <label><span data-t="k"></span> <input type="range" data-input="k" min="0" max="1" step="0.01"> <span class="sdf-k"></span></label>
    <label><span data-t="steps"></span> <input type="range" data-input="steps" min="8" max="256" step="1"> <span class="sdf-steps"></span></label>
    <label class="sdf-slice" hidden><span data-t="slice"></span> <input type="range" data-input="slice" min="0.05" max="2.2" step="0.01"></label>
    <div class="lab-seg" role="group">
      <button type="button" class="lab-b" data-toggle="relax" data-t="relax"></button>
      <button type="button" class="lab-b" data-toggle="soft" data-t="soft"></button>
      <button type="button" class="lab-b" data-toggle="ao" data-t="ao"></button>
    </div>
  </div>
  <div class="sdf-editor">
    <span class="sdf-selname"></span>
    <div class="sdf-seltools" hidden>
      <div class="lab-seg" role="group">
        <button type="button" class="lab-b" data-op="0" data-t="op0"></button>
        <button type="button" class="lab-b" data-op="1" data-t="op1"></button>
      </div>
      <label><span data-t="size"></span> <input type="range" data-input="size" min="0.3" max="1.8" step="0.01"></label>
      <label><span data-t="height"></span> <input type="range" data-input="height" min="-0.6" max="3" step="0.01"></label>
      <button type="button" class="lab-b lab-solo" data-action="delete" data-t="del"></button>
    </div>
  </div>
  <p class="lab-caption"><span data-t="caption"></span> <span data-t="more"></span> <a href="{{ '/blog/2026/graphics-08-geometry-processing/' | relative_url }}" data-t="l08"></a> · <a href="{{ '/blog/2026/graphics-05-ray-and-path-tracing/' | relative_url }}" data-t="l05"></a></p>
</div>
